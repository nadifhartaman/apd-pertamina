# ============================================
# FFmpeg Streaming Configuration
# ============================================

# Pilih preset encoding:
# - low_latency     : Ultra fast, rendah quality, untuk live monitoring (good for mobile)
# - balanced        : Best untuk production (RECOMMENDED)
# - high_quality    : Better quality, lebih besar file size
# - copy_stream     : No re-encoding, paling ringan tapi hanya jika format sudah supported
FFMPEG_PRESET=balanced

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pertamina_apd

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=production

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-secret-key-here

# ============================================
# FFMPEG Presets Details:
# ============================================
#
# low_latency:
#   - Video: 800kbps, CRF 35, ultrafast (minimal CPU)
#   - Audio: 32kbps, 16kHz (mono quality)
#   - HLS Segment: 0.5s (maximum latency)
#   - Best for: Monitoring, weak networks, mobile
#   - CPU: Very Low ✅
#   - Bandwidth: ~100KB/s
#
# balanced (RECOMMENDED):
#   - Video: 1200kbps, CRF 32, veryfast
#   - Audio: 48kbps, 22kHz
#   - HLS Segment: 1s
#   - Best for: Most use cases
#   - CPU: Low-Medium
#   - Bandwidth: ~150KB/s
#
# high_quality:
#   - Video: 2500kbps, CRF 28, fast
#   - Audio: 96kbps, 44.1kHz
#   - HLS Segment: 2s
#   - Best for: Detail viewing, archive
#   - CPU: Medium
#   - Bandwidth: ~300KB/s
#
# copy_stream:
#   - No re-encoding (direkta copy codec dari source)
#   - Video/Audio: Sesuai source
#   - Best for: High bitrate sources, fast conversion
#   - CPU: Minimum ✅
#   - Bandwidth: Depends on source
#
# ============================================
# Rekomendasi Bandwidth:
# ============================================
#
# 1 Camera @ balanced:    ~150KB/s
# 5 Cameras @ balanced:   ~750KB/s (~6Mbps)
# 10 Cameras @ balanced:  ~1.5Mbps
# 20 Cameras @ low_latency: ~2Mbps
#
# Untuk jaringan terbatas, gunakan low_latency
# Untuk visual terbaik, gunakan high_quality
#
# ============================================
